---
// Home page ( / )
import Base from '../layouts/Base.astro';
import { VALUES } from '../data/values.js';
import { FEATURED, PROJECTS } from '../data/projects.js';
import { PHONE, PHONE_LINK, EMAIL, EMAIL_LINK } from '../data/site.js';
---

<Base>
  <main>
    <!-- Hero: kitchen photo clipped to a gable (house) shape -->
    <section class="container hero">
      <div class="gable">
        <div class="gable-photo">
          <img src="/lexen/kitchen.jpg" alt="Renovated kitchen with navy island" />
        </div>
        <!-- The 6px slate house outline, drawn 14px outside the photo -->
        <svg class="gable-outline" viewBox="0 0 100 60" preserveAspectRatio="none" aria-hidden="true">
          <polyline points="0,60 0,20.4 50,0 100,20.4 100,60" fill="none" stroke="#4F5A6E" vector-effect="non-scaling-stroke" />
        </svg>
      </div>

      <div class="auto-grid-wide hero-text">
        <h1 class="display">Exceptional home <em>renovations.</em></h1>
        <div class="hero-side">
          <p class="lead">Kitchens, bathrooms and full home renovations across Vancouver and the Lower Mainland, from a family-owned team with 15 years and over 100 projects behind it.</p>
          <div class="buttons">
            <a href="/projects" class="btn btn-solid">View our projects</a>
            <a href="/contact" class="btn btn-outline">Contact us</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust. Quality. Experience. -->
    <section class="dark">
      <div class="container auto-grid values">
        <div class="values-photo">
          <img src="/lexen/bath.jpg" alt="Bathroom with brick feature wall and soaker tub" />
        </div>
        <div class="values-list">
          {
            VALUES.map((value) => (
              <div class="value">
                <span class="value-number">{value.number}</span>
                <div class="value-body">
                  <h2 class="display">{value.title}</h2>
                  <p>{value.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Recent projects -->
    <section class="container recent">
      <div class="auto-grid recent-head">
        <h2 class="display">Recent <em>projects.</em></h2>
        <a href="/projects" class="text-link">View all {PROJECTS.length} projects</a>
      </div>
      <div class="project-list">
        {
          FEATURED.map((project) => (
            <div class="project-row">
              <span class="number">{project.number}</span>
              <h3 class="display">{project.title}</h3>
              <p>{project.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- We know every trade -->
    <section class="trades-band">
      <div class="container auto-grid trades">
        <div class="trades-text">
          <span class="label trades-label">Family-owned · 15 years · 100+ projects</span>
          <h2 class="display">We know every trade <em>on your job.</em></h2>
          <p class="lead">Understanding the intricacies of each trade lets us oversee and manage a high quality of work, and find creative solutions when a project calls for them.</p>
          <a href="/about" class="text-link">Meet Allen and Alex</a>
        </div>
        <div class="trades-photo">
          <img src="/lexen/kitchen.jpg" alt="Lexen kitchen renovation" />
        </div>
      </div>
    </section>

    <!-- Closing band -->
    <section class="container cta">
      <div class="cta-text">
        <h2 class="display">Create your <em>dream home.</em></h2>
        <p class="lead">Tell us about your project today.</p>
      </div>
      <div class="cta-contact">
        <a href={PHONE_LINK} class="phone">{PHONE}</a>
        <a href={EMAIL_LINK}>{EMAIL}</a>
      </div>
    </section>
  </main>
</Base>

<style>
  /* ----- Hero ----- */
  .hero {
    padding-top: clamp(40px, 5vw, 72px);
  }

  .gable {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
  }

  .gable-photo {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--line-soft);
    clip-path: polygon(50% 0, 100% 34%, 100% 100%, 0 100%, 0 34%);
  }

  .gable-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 70%;
  }

  .gable-outline {
    position: absolute;
    inset: -14px;
    width: calc(100% + 28px);
    height: calc(100% + 28px);
    pointer-events: none;
    overflow: visible;
    stroke-width: 6px;
  }

  @media (max-width: 699px) {
    .gable-photo {
      aspect-ratio: 1 / 1;
    }
  }

  .hero-text {
    gap: 24px 80px;
    padding: clamp(36px, 4vw, 64px) 0 clamp(72px, 9vw, 128px);
    align-items: end;
  }

  .hero-text h1 {
    font-size: clamp(56px, 7.6vw, 128px);
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  .hero-side {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero-side .lead {
    max-width: 30em;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ----- Values ----- */
  .values {
    padding-top: var(--section-y);
    padding-bottom: var(--section-y);
    gap: 56px 96px;
    align-items: center;
  }

  .values-photo {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    max-width: 520px;
    width: 100%;
    justify-self: center;
    clip-path: polygon(50% 0, 100% 20%, 100% 100%, 0 100%, 0 20%);
  }

  .values-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .values-list {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .value {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 20px;
    border-top: 1px solid var(--slate);
    padding-top: 24px;
  }

  .value-number {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 30px;
    color: var(--label-on-dark);
  }

  .value-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .value-body h2 {
    font-size: clamp(40px, 4vw, 60px);
    line-height: 1;
  }

  .value-body p {
    margin: 0;
    font-size: 18px;
    color: var(--on-dark);
    max-width: 30em;
  }

  /* ----- Recent projects ----- */
  .recent {
    padding-top: var(--section-y);
    padding-bottom: var(--section-y);
  }

  .recent-head {
    gap: 24px 96px;
    align-items: end;
    margin-bottom: clamp(36px, 4vw, 56px);
  }

  .recent-head h2 {
    font-size: clamp(48px, 6vw, 100px);
    line-height: 0.95;
  }

  .recent-head .text-link {
    justify-self: start;
  }

  .recent h3 {
    font-size: clamp(30px, 3vw, 46px);
    line-height: 1.02;
  }

  /* ----- Trades ----- */
  .trades-band {
    background: var(--sand);
  }

  .trades {
    padding-top: var(--section-y);
    padding-bottom: var(--section-y);
    gap: 48px 96px;
    align-items: start;
  }

  .trades-text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .trades-label {
    letter-spacing: 0.18em;
    color: var(--slate);
  }

  .trades-text h2 {
    font-size: clamp(44px, 5vw, 84px);
    line-height: 0.98;
  }

  .trades-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--line-soft);
    max-width: 520px;
    width: 100%;
    justify-self: end;
  }

  .trades-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% center;
  }

  /* ----- Closing band ----- */
  .cta-text {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cta-contact {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 20px;
  }

  .cta-contact a {
    color: var(--ink);
  }

  .cta-contact .phone {
    text-decoration: none;
    font-weight: 600;
  }
</style>
