---
// Projects page ( /projects )
// The project names and descriptions live in src/data/projects.js.
import Base from '../layouts/Base.astro';
import { PROJECTS, PHOTO_PROJECTS } from '../data/projects.js';
---

<Base title="Projects | Lexen Construction">
  <main>
    <section class="container page">
      <h1 class="display">Our projects</h1>
      <p class="lead intro">Kitchens, bathrooms, full home renovations and a few custom builds.</p>

      <!-- The two projects that have photos so far -->
      <div class="auto-grid photos">
        {
          PHOTO_PROJECTS.map((project) => (
            <figure>
              <div class="photo">
                <img src={project.image} alt={project.alt} style={`object-position: ${project.position}`} />
              </div>
              <figcaption>{project.caption}</figcaption>
            </figure>
          ))
        }
      </div>

      <!-- All 13 projects as a numbered list -->
      <div class="project-list">
        {
          PROJECTS.map((project) => (
            <div class="project-row">
              <span class="number">{project.number}</span>
              <h2 class="display">{project.title}</h2>
              <p>{project.description}</p>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</Base>

<style>
  .page {
    padding-top: var(--page-top);
    padding-bottom: var(--page-top);
  }

  h1 {
    font-size: clamp(56px, 7vw, 120px);
    line-height: 0.95;
    margin-bottom: 12px;
  }

  .intro {
    margin-bottom: clamp(36px, 4vw, 56px);
  }

  .photos {
    gap: 24px;
    margin-bottom: clamp(48px, 6vw, 80px);
  }

  figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .photo {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--line-soft);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Slightly tighter rows and smaller titles than on the Home page. */
  .project-row {
    padding: 24px 0;
  }

  .project-row h2 {
    font-size: clamp(28px, 2.8vw, 42px);
    line-height: 1.05;
  }
</style>
