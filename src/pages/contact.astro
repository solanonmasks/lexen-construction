---
// Contact page ( /contact )
import Base from '../layouts/Base.astro';
import { PHONE, PHONE_LINK, EMAIL, EMAIL_LINK } from '../data/site.js';
---

<Base title="Contact | Lexen Construction">
  <main>
    <section class="container auto-grid contact">
      <div class="details">
        <h1 class="display">Let’s discuss your <em>next project.</em></h1>
        <p class="lead">Fill out the form, or call us to set up a free in-home consultation.</p>
        <a href={PHONE_LINK} class="phone">{PHONE}</a>
        <a href={EMAIL_LINK} class="email">{EMAIL}</a>
        <div class="areas">
          <span class="label areas-label">Service areas</span>
          <span>Vancouver &amp; the Lower Mainland</span>
          <span>Rossland &amp; Area</span>
        </div>
      </div>

      <!--
        TODO (before launch): this form does NOT send anything yet.
        Right now it only shows the thank-you message in the browser.
        Connect it to an email/form service (for example Formspree, Basin,
        Web3Forms or a Vercel serverless function) so submissions reach
        info@lexen.construction. Usually that means adding an `action="..."`
        URL and `method="POST"` to the <form> below and removing the script
        at the bottom of this file.
      -->
      <form id="booking-form" class="form">
        <label>Name<input name="name" required /></label>
        <label>Email<input name="email" type="email" required /></label>
        <label>Phone<input name="phone" type="tel" /></label>
        <label>Address<input name="address" /></label>
        <label>Subject<input name="subject" /></label>
        <label>Message<textarea name="message" rows="4" required></textarea></label>
        <button type="submit" class="btn btn-solid">Book a meeting</button>
      </form>

      <p id="thank-you" class="thank-you" hidden>Thank you. We’ll be in touch soon.</p>
    </section>
  </main>

  <script is:inline>
    // Placeholder submit: swap the form for the thank-you message.
    // See the TODO above the form — remove this once a real service is connected.
    {
      const form = document.getElementById('booking-form');
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        form.hidden = true;
        document.getElementById('thank-you').hidden = false;
      });
    }
  </script>
</Base>

<style>
  .contact {
    padding-top: var(--page-top);
    padding-bottom: var(--page-top);
    gap: 48px 96px;
    align-items: start;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .details h1 {
    font-size: clamp(56px, 7vw, 120px);
    line-height: 0.95;
  }

  .phone {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 24px;
  }

  .email {
    color: var(--ink);
    font-size: 20px;
  }

  .areas {
    border-top: 1px solid var(--line);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 19px;
  }

  .areas-label {
    color: var(--slate);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form[hidden] {
    display: none;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  input,
  textarea {
    border: none;
    border-bottom: 1px solid var(--ink);
    border-radius: 0;
    background: transparent;
    font-size: 19px;
    padding: 10px 0;
    outline: none;
    color: var(--ink);
    letter-spacing: normal;
    text-transform: none;
  }

  /* Visible focus for keyboard users (the prototype removed the outline). */
  input:focus-visible,
  textarea:focus-visible {
    border-bottom-color: var(--slate);
    box-shadow: 0 1px 0 0 var(--slate);
  }

  textarea {
    resize: vertical;
  }

  .form button {
    align-self: flex-start;
    padding: 18px 30px;
  }

  .thank-you {
    margin: 0;
    font-family: var(--font-display);
    font-size: 44px;
    line-height: 1.1;
  }
</style>
